{
  "name": "saturn-core",
  "version": "1.0.0",
  "saturnApi": "1.0.0",
  "description": "A lightweight, customisable, and extensible code editor.",
  "author": "Lewis Milburn",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@preact/signals": "^2.11.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "6.8.11",
    "fflate": "^0.8.2",
    "hash-wasm": "^4.12.0",
    "node-pty": "^1.1.0",
    "preact": "^11.0.2",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "marked": "^18.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "productName": "Saturn"
}

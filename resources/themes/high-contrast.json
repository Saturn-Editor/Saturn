{
  "id": "high-contrast",
  "name": "High Contrast",
  "description": "Maximum contrast between text and background.",
  "light": {
    "colors": {
      "app": "white",
      "editor": "white",
      "panel": "neutral-100",
      "raised": "white",
      "divider": "neutral-600",
      "border": "black",
      "text": "black",
      "strong": "black",
      "muted": "neutral-700",
      "accent": "blue-800",
      "on-accent": "white",
      "selection": "blue-700/25",
      "hover": "black/10",
      "error": "red-700",
      "warning": "orange-700"
    },
    "syntax": [
      { "scope": "comment", "color": "neutral-700", "fontStyle": "italic" },
      { "scope": "string", "color": "green-800" },
      { "scope": "keyword", "color": "blue-800", "fontStyle": "bold" },
      { "scope": "storage", "color": "blue-800", "fontStyle": "bold" },
      { "scope": "storage.type", "color": "teal-800" },
      { "scope": "constant.numeric", "color": "fuchsia-800" },
      { "scope": "constant.language", "color": "fuchsia-800" },
      { "scope": "constant.character.escape", "color": "red-800" },
      { "scope": "entity.name.function", "color": "indigo-900" },
      { "scope": "support.function", "color": "indigo-900" },
      { "scope": "entity.name.type", "color": "teal-800" },
      { "scope": "entity.name.class", "color": "teal-800" },
      { "scope": "support.type", "color": "teal-800" },
      { "scope": "variable", "color": "black" },
      { "scope": "entity.name.tag", "color": "blue-800" },
      { "scope": "entity.other.attribute-name", "color": "amber-900" },
      { "scope": "invalid.illegal", "color": "red-700", "fontStyle": "underline" },
      { "scope": "markup.heading", "color": "blue-800", "fontStyle": "bold" },
      { "scope": "markup.bold", "fontStyle": "bold" },
      { "scope": "markup.italic", "fontStyle": "italic" },
      { "scope": "markup.underline.link", "color": "blue-800", "fontStyle": "underline" },
      { "scope": "markup.inline.raw", "color": "red-800" }
    ]
  },
  "dark": {
    "colors": {
      "app": "black",
      "editor": "black",
      "panel": "neutral-900",
      "raised": "neutral-900",
      "divider": "neutral-500",
      "border": "white",
      "text": "white",
      "strong": "white",
      "muted": "neutral-300",
      "accent": "yellow-300",
      "on-accent": "black",
      "selection": "yellow-300/35",
      "hover": "white/15",
      "error": "red-400",
      "warning": "orange-300"
    },
    "syntax": [
      { "scope": "comment", "color": "neutral-300", "fontStyle": "italic" },
      { "scope": "string", "color": "lime-300" },
      { "scope": "keyword", "color": "yellow-300", "fontStyle": "bold" },
      { "scope": "storage", "color": "yellow-300", "fontStyle": "bold" },
      { "scope": "storage.type", "color": "cyan-300" },
      { "scope": "constant.numeric", "color": "fuchsia-300" },
      { "scope": "constant.language", "color": "fuchsia-300" },
      { "scope": "constant.character.escape", "color": "orange-300" },
      { "scope": "entity.name.function", "color": "sky-200" },
      { "scope": "support.function", "color": "sky-200" },
      { "scope": "entity.name.type", "color": "cyan-200" },
      { "scope": "entity.name.class", "color": "cyan-200" },
      { "scope": "support.type", "color": "cyan-200" },
      { "scope": "variable", "color": "white" },
      { "scope": "entity.name.tag", "color": "yellow-300" },
      { "scope": "entity.other.attribute-name", "color": "orange-200" },
      { "scope": "invalid.illegal", "color": "red-400", "fontStyle": "underline" },
      { "scope": "markup.heading", "color": "yellow-300", "fontStyle": "bold" },
      { "scope": "markup.bold", "fontStyle": "bold" },
      { "scope": "markup.italic", "fontStyle": "italic" },
      { "scope": "markup.underline.link", "color": "sky-300", "fontStyle": "underline" },
      { "scope": "markup.inline.raw", "color": "orange-300" }
    ]
  }
}
